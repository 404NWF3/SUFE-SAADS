# =============================================================================
# SAADS 环境变量配置
# 复制此文件为 .env 并填入实际值
# =============================================================================

# --- OpenAI / LLM 配置 ---
OPENAI_API_KEY=sk-your-openai-api-key
# 可选: 指向兼容 OpenAI API 的第三方服务（如 Azure, DeepSeek, 本地 Ollama 等）
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=qwen-max
# OPENAI_FAST_MODEL=qwen-turbo

# --- 数据源 API Key ---
# NVD (National Vulnerability Database)
# 申请地址: https://nvd.nist.gov/developers/request-an-api-key
# 无 key 限速: 5 次/30秒; 有 key: 50 次/30秒
# NVD_API_KEY=your-nvd-api-key

# GitHub Personal Access Token
# 创建地址: https://github.com/settings/tokens (需要 read:packages 权限即可)
# 无 token 限速: 60 次/小时; 有 token: 5000 次/小时
# GITHUB_TOKEN=ghp_your-github-token

# VirusTotal API Key (可选 - 用于payload恶意特征检测)
# 申请地址: https://www.virustotal.com/gui/join-us
# 免费账户: 4 次请求/分钟
# VIRUSTOTAL_API_KEY=your-virustotal-api-key

# AlienVault OTX API Key (可选 - 开放威胁情报交换)
# 申请地址: https://otx.alienvault.com/
# 免费账户: 10 次请求/秒
# ALIENVAULT_API_KEY=your-alienvault-api-key

# HuggingFace Token (可选 - 提升 API 速率限制)
# 创建地址: https://huggingface.co/settings/tokens
# 无 token 也可使用 Models API 和 Daily Papers API
# HF_TOKEN=hf_your-huggingface-token

# --- 备用配置 ---
# GOOGLE_API_KEY=your-google-api-key

# =============================================================================
# Phase 1 新增: 向量数据库 + 关系数据库 + Embedding 配置
# =============================================================================

# --- Qdrant 向量数据库 ---
# 两种运行模式:
#   开发/测试: 留空，自动使用 data/qdrant/ 本地文件（同步客户端）
#   生产/Docker: 填写 Docker 服务地址
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-api-key

# Qdrant Collection 名称（一般无需修改）
# QDRANT_COLLECTION_ATTACKS=saads_attacks

# --- SQLAlchemy 数据库 ---
# 默认: 嵌入式 SQLite（data/saads.db），无需独立服务
# 切换 PostgreSQL（生产）: postgresql+asyncpg://user:pass@host:5432/saads
# DATABASE_URL=sqlite+aiosqlite:///data/saads.db

# --- WP1-1 db 模块 PostgreSQL（psycopg3 同步栈） ---
# 优先使用 DSN；若不设置则使用下方 HOST/PORT/DB/USER/PASSWORD 组合
# POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/saads
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=saads
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_SCHEMA=wp11
# POSTGRES_MIN_SIZE=1
# POSTGRES_MAX_SIZE=10
# POSTGRES_CONNECT_TIMEOUT=5
# POSTGRES_STATEMENT_TIMEOUT_MS=30000
# POSTGRES_APPLICATION_NAME=saads-db

# --- WP1-1 embedded Qdrant ---
# 使用本地嵌入式 Qdrant 模式，不需要 Docker，也不需要单独启动 Qdrant Server。
# QDRANT_LOCAL_PATH=.runtime/wp11/vector_memory
# QDRANT_COLLECTION_NAME=wp11_attack_signature_memory

# --- Embedding 配置 ---
# 选择 Embedding 后端:
#   "openai"                — 使用 OpenAI Embeddings API（默认，需 OPENAI_API_KEY，按 token 计费）
#   "sentence-transformers" — 本地推理（无 API 费用，需安装可选依赖 saads[local-embed]）
# EMBEDDING_PROVIDER=openai

# Embedding 模型名称:
#   openai 后端默认:                text-embedding-3-small（1536 维）
#   sentence-transformers 后端默认: all-MiniLM-L6-v2（384 维）
# 注意: Qdrant collection 一旦创建，向量维度不可更改！
# EMBEDDING_MODEL=text-embedding-3-small

# Embedding 向量维度（必须与所选模型一致）
# EMBEDDING_DIMENSIONS=1536

# =============================================================================
# Phase 5 新增: REST API 认证
# =============================================================================

# --- SAADS API Key ---
# 用于保护 REST API 端点（X-API-Key 请求头）
# 未设置时认证禁用（开发友好默认值）；生产环境建议设置为强随机密钥
# 示例生成: python -c "import secrets; print(secrets.token_hex(32))"
# SAADS_API_KEY=your-strong-random-api-key

# =============================================================================
# 部署配置
# =============================================================================

# --- CORS 跨域来源 ---
# 逗号分隔，填入所有允许访问后端 API 的前端地址
# 开发默认值已内置，生产环境需追加服务器 IP 或域名
# 示例（生产）：CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://your-server-ip
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# WP1-5 Sentinel 情报采集 workspace 配置
# =============================================================================

# Sentinel workspace 路径
# 同一台服务器时指向 OpenClaw workspace 目录（推荐，OpenClaw 和 SAADS 共享同一份文件）
# 默认值：~/.openclaw/workspace-llm-security-intel
# SENTINEL_WORKSPACE_ROOT=C:\Users\YourUser\.openclaw\workspace-llm-security-intel

# OpenClaw Gateway（可选，用于通过 Gateway RPC 触发完整 Sentinel Agent 流水线）
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=your-openclaw-gateway-token
# 兼容旧变量名；若未设置 OPENCLAW_GATEWAY_TOKEN，后端会回退读取 OPENCLAW_HOOKS_TOKEN
# OPENCLAW_HOOKS_TOKEN=your-openclaw-gateway-token

# Sentinel -> OpenClaw 超时覆盖（毫秒）
# 默认 agent timeout 为 3600000（1 小时），wait timeout 默认比它多 5 分钟
# 设置为 0 / none / unlimited 可关闭这一层覆盖，改用 OpenClaw 自身默认配置
# OPENCLAW_AGENT_TIMEOUT_MS=3600000
# OPENCLAW_WAIT_TIMEOUT_MS=3900000
# OPENCLAW_WAIT_TIMEOUT_S=3930
